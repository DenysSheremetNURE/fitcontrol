# Copy to .env and replace every change_me.
# Passwords: Latin letters and digits only. Other characters break connection strings and URLs.
# The real .env must never be committed.

# --- Shared by all services (values must match everywhere) ---
JWT_ISSUER=fitcontrol-auth
JWT_AUDIENCE=fitcontrol
AUTH_METADATA_URL=http://auth-service:8080/.well-known/openid-configuration
JWKS_URL=http://auth-service:8080/.well-known/jwks.json
GATEWAY_PORT=8080

# --- RabbitMQ ---
RABBITMQ_USER=fitcontrol
RABBITMQ_PASSWORD=change_me

# --- Auth service ---
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me
AUTH_DB_PORT=5433
AUTH_PORT=5001

# --- Meal planning service ---
MEALPLANNING_DB_NAME=meal_planning
MEALPLANNING_DB_USER=meal_planning
MEALPLANNING_DB_PASSWORD=change_me
MEALPLANNING_API_PORT=5002

# --- Analytics service ---
ANALYTICS_DB_NAME=analytics_db
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=change_me
ANALYTICS_PORT=8000