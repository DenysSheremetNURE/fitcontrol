{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "MetadataAddress": "https://localhost:7113/.well-known/openid-configuration",
    "Issuer": "authservice",
    "Audience": "authservice-api"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "meals": {
        "ClusterId": "meals",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/meals/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "d1": { "Address": "https://localhost:7113/" } }
      },
      "meals": {
        "Destinations": { "d1": { "Address": "http://localhost:6001/" } }
      }
    }
  }
}